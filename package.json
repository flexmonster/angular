{
  "name": "@flexmonster/angular",
  "version": "0.0.0",
  "description": "Angular wrapper for Flexmonster Pivot",
  "license": "https://www.flexmonster.com/software-license-agreement/",
  "author": {
    "name": "Flexmonster",
    "email": "help@flexmonster.com"
  },
  "repository": "https://github.com/flexmonster/angular",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build @flexmonster/angular",
    "build:testapp": "ng build test-app",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/smoke.mjs",
    "test:ng": "ng test",
    "serve:ssr:test-app": "node dist/test-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/ssr": "^21.2.3",
    "@flexmonster/angular": "^3.0.0-beta.1",
    "@flexmonster/flexmonster": "^3.0.0-beta.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
